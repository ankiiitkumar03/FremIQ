# Required for every production deployment.
DATABASE_URL=postgresql://user:password@host:5432/fremiq
# Generate a random value with at least 32 characters. Keep it stable or saved integration secrets cannot be decrypted.
FREMIQ_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
# Mount a persistent writable volume here in production. Do not use ephemeral serverless storage.
FREMIQ_DATA_DIR=.data

# Optional: used when the web app can reach the FREMIQ Local Agent.
FREMIQ_AGENT_URL=http://127.0.0.1:8765

# Optional brand overrides.
NEXT_PUBLIC_BRAND_NAME=FREMIQ
NEXT_PUBLIC_BRAND_TAGLINE=The intelligence behind every frame.
NEXT_PUBLIC_BRAND_ACCENT="#A78BFA"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_BRAND_WEBSITE=https://example.com
